# 只放在云平台的加密环境变量中，不要提交真实令牌。
DONGJIEXI_CLOUD=1
DONGJIEXI_OLLAMA_URL=https://your-private-ollama.example.com
DONGJIEXI_OLLAMA_TOKEN=replace-in-host-secret-store
# 用户在手机端输入此口令后，服务器只签发短期内存会话；口令本身不写入浏览器配置。
DONGJIEXI_ACCESS_KEY=replace-with-a-long-random-access-key
DONGJIEXI_ALLOWED_MODELS=qwen3.5:4b
# 仅在前端与 API 分域部署时填写，多个来源用英文逗号分隔。
DONGJIEXI_ALLOWED_ORIGINS=https://your-pages.example.com
# 只有确认前置反向代理会覆盖 X-Forwarded-For 时才设为 1。
DONGJIEXI_TRUST_PROXY=0
